#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        gui_sk: gui_sk {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
        };
    };

    chosen {
        zmk,physical-layout = &default_layout;
    };
    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&trans  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp CAPS     &none  &kp Y  &kp U  &kp I  &kp O  &kp P  &trans
&trans  &kp A  &kp S  &kp D  &kp F  &kp G  &none        &none  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &trans
&trans  &kp Z  &kp X  &kp C  &kp V  &kp B                      &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &trans
                      &kp LCTRL  &kp LSHFT  &mo 1       &kp SPACE  &kp RET  &mo 2
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none    &none  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &none   &none   &none   &none   &none   &none    &none  &none   &none   &none   &none   &none   &trans
&trans  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &trans
                        &trans  &trans  &trans           &trans  &trans  &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none  &bt BT_CLR    &none  &studio_unlock  &none  &none  &none  &none  &trans
&trans  &none         &none         &none         &none  &none  &none         &none           &none  &none  &none  &none  &none  &trans
&trans  &none         &none         &none         &none  &none                                &none  &none  &none  &none  &none  &trans
                                    &trans        &trans &trans               &trans &trans &trans
            >;
        };
    };
};
