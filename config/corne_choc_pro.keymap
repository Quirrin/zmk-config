 *
 * Keymap translated from corne-keymaps.vil (Vial/QMK) → ZMK
 * Layout: Colemak-DH variant, 3 primary layers + BT/system layer
 *
 * Thumb mapping:
 *   Left:  &mt RIGHT_ALT TAB | &mst LCTRL LSHFT | &mt LEFT_GUI SPACE
 *   Right: &lt 1 RET | &lt 2 ESC | &kp BACKSPACE
 *   MST: tap=sticky LSHFT, hold=LCTRL (mod sticky tap)
 *
 * Left encoder (row 0-1): volume up/down
 * Right encoder: brightness (configured per layer via sensor-bindings)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };

    behaviors {
        /* MST: mod sticky tap (hold = LCTRL, tap = sticky LSHFT) */
        mst: mod_sticky_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MST";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
        };
    };

    /*
     * Combo: left-thumb inner (36) + right-thumb outer (39) → BT layer (layer 3)
     * Combo: left-thumb mid (35) + right-thumb mid (38) → FN layer (layer 2)
     * Key positions on Corne Choc Pro 5-col (0-indexed, 40 keys total):
     *   Row 0: 0-11, Row 1: 12-23, Row 2: 24-33, Thumbs: 34-39 (L0=34, L1=35, L2=36, R0=37, R1=38, R2=39)
     */
    combos {
        compatible = "zmk,combos";
        combo_bt {
            timeout-ms = <50>;
            key-positions = <36 39>;
            bindings = <&mo 3>;
        };
        combo_fn {
            timeout-ms = <50>;
            key-positions = <35 38>;
            bindings = <&mo 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ════════════════════════════════════════════════════════════════════
        // Layer 0 – BASE (Colemak-DH variant)
        // ════════════════════════════════════════════════════════════════════
        default_layer {
            display-name = "BASE";
            bindings = <
                &kp Q  &kp W  &kp F  &kp P  &kp B  &kp CAPS    &none     &kp J     &kp L  &kp U     &kp Y    &kp SEMI
                &kp A  &kp R  &kp S  &kp T  &kp G  &sk RALT    &kp PSCRN &kp M     &kp N  &kp E     &kp I    &kp O
                &kp Z  &kp X  &kp C  &kp D  &kp V              &kp K     &kp H  &kp COMMA &kp DOT  &kp FSLH
                             &mt RIGHT_ALT TAB  &mst LCTRL LSHFT  &mt LEFT_GUI SPACE    &lt 1 RET  &lt 2 ESC  &kp BACKSPACE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_DN C_VOL_UP
                &inc_dec_kp C_BRI_DN C_BRI_UP
                &inc_dec_kp C_PREV C_NEXT
                &inc_dec_kp C_VOL_DN C_VOL_UP
            >;
        };

        // ════════════════════════════════════════════════════════════════════
        // Layer 1 – SYM / NAV  (activated via &lt 1 RET on right thumb)
        // ════════════════════════════════════════════════════════════════════
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp N1      &kp N2     &kp N3    &kp N4    &kp N5    &rgb_ug RGB_BRI    &rgb_ug RGB_BRD &kp N6    &kp N7   &kp N8      &kp N9   &kp N0
                &kp GRAVE   &kp SQT    &kp MINUS &kp EQUAL &kp ASTRK &kp LS(N5)         &kp LS(N2)      &kp DEL   &kp LEFT &kp UP      &kp DOWN &kp RIGHT
                &kp LS(N9)  &kp LS(N0) &kp LBKT  &kp RBKT  &kp LS(N6)                  &kp BSLH        &kp EXCL &kp LS(N7)  &kp HASH &kp LS(N4)
                                                  &trans    &trans    &trans             &trans          &trans   &trans
            >;
        };

        // ════════════════════════════════════════════════════════════════════
        // Layer 2 – FN / MEDIA  (activated via combo: both inner thumbs)
        //
        // Left: media + brightness keys, F1-F5
        // Right: F6-F12, page navigation
        // ════════════════════════════════════════════════════════════════════
        fn_layer {
            display-name = "FN";
            bindings = <
                &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans  &kp C_BRI_DN &kp C_BRI_UP    &trans  &trans    &trans    &trans    &trans   &trans
                &trans     &trans       &trans        &trans  &trans       &kp F6           &kp F7  &kp HOME  &kp PG_UP &kp PG_DN &kp END  &trans
                &kp F1     &kp F2       &kp F3        &kp F4  &kp F5                                &kp F8   &kp F9    &kp F10   &kp F11  &kp F12
                                                      &trans  &trans       &trans           &trans  &trans   &trans
            >;
        };

        // ════════════════════════════════════════════════════════════════════
        // Layer 3 – BT / SYSTEM  (combo: outer left + outer right thumb)
        //
        // BT profile selection, clear, reset, bootloader, studio unlock
        // ════════════════════════════════════════════════════════════════════
        bt_layer {
            display-name = "BT";
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR    &sys_reset &bootloader    &trans &trans &trans &none
                &trans       &trans        &trans        &trans        &trans        &trans         &trans     &rgb_ug RGB_TOG &trans &trans &trans &trans
                &trans       &trans        &trans        &trans        &trans                                  &trans         &trans &trans &trans &trans
                                                         &trans        &trans        &trans         &trans     &trans         &trans
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans            &trans &trans &trans &trans &trans
                                    &trans &trans &trans    &trans &trans &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans            &trans &trans &trans &trans &trans
                                    &trans &trans &trans    &trans &trans &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans            &trans &trans &trans &trans &trans
                                    &trans &trans &trans    &trans &trans &trans
            >;
        };
    };
};
